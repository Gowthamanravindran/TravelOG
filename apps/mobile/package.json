{
  "name": "@travelog/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@travelog/core": "workspace:*",
    "@travelog/db": "workspace:*",
    "@travelog/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "3.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3",
    "better-sqlite3": "^13.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "export:android": "expo export --platform android --output-dir dist"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|uuid|drizzle-orm|@travelog/.*)"
    ]
  }
}
