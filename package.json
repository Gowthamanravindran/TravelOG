{
  "name": "travelog",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/core/src/db.types.ts",
    "dev": "pnpm install --frozen-lockfile --prefer-offline && pnpm --filter @travelog/mobile start --dev-client"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3"
    ]
  }
}
